# ============================================
# ValueCell Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# Application Settings
APP_ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# DashScope API (Recommended)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# OpenRouter API (Alternative)
OPENROUTER_API_KEY=your-openrouter-api-key-here
YOUR_SITE_URL=https://github.com/ValueCell-ai/valuecell
YOUR_SITE_NAME=ValueCell

# Google API (Optional, for Gemini models)
GOOGLE_API_KEY=your-google-api-key-here

# SiliconFlow API (Optional)
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# Data Sources
SEC_EMAIL=your-email@example.com
FINNHUB_API_KEY=your-finnhub-api-key-here

# Embedding Configuration (if using DashScope embeddings)
EMBEDDER_API_KEY=your-dashscope-api-key-here
EMBEDDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDER_MODEL_ID=text-embedding-v2
EMBEDDER_DIMENSION=1536

# Agent Overrides
# SUPER_AGENT_MODEL_ID=qwen3-max
# RESEARCH_AGENT_MODEL_ID=qwen3-max
# AUTO_TRADING_AGENT_MODEL_ID=qwen3-max